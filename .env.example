# --- Copie este arquivo para .env e preencha ---

# Crie em https://my.telegram.org  (API Development Tools)
API_ID=123456
API_HASH=abcdef0123456789abcdef0123456789

# Crie o bot conversando com @BotFather no Telegram (/newbot)
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ID (número) do grupo privado onde os alertas chegam.
# Descubra mandando qualquer msg no grupo e consultando @userinfobot,
# ou rode: print(await bot_client.get_entity(...)) — o bot precisa ser
# ADM do grupo e o grupo precisa ter ao menos 1 mensagem.
TARGET_CHAT_ID=-1001234567890

# Opcional: IDs de grupos/canais específicos para monitorar (separados por vírgula).
# Deixe vazio para monitorar TODOS os grupos/canais que você participa.
MONITORED_CHATS=
